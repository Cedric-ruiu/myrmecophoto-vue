{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "node scripts/generate-image-manifest.mjs && nuxt dev --host 0.0.0.0",
    "manifest": "node scripts/generate-image-manifest.mjs",
    "serveSSG": "npx serve ./dist",
    "generate": "node scripts/generate-image-manifest.mjs && nuxt generate",
    "generate:local": "NUXT_SITE_ENV=production NUXT_SITE_URL=http://localhost:3000 node scripts/generate-image-manifest.mjs && NUXT_SITE_ENV=production NUXT_SITE_URL=http://localhost:3000 nuxt generate",
    "serve-generate": "yarn generate & yarn serveSSG",
    "serve-generate:local": "yarn generate:local && yarn serveSSG",
    "preview": "nuxt preview",
    "format": "yarn format:tailwind && yarn format:script && yarn format:style",
    "format:script": "eslint . --fix",
    "format:style": "stylelint \"assets/*.scss\" \"**/*.vue\" --fix",
    "format:tailwind": "tailwind-sorter sort -i \"**/*.vue\"",
    "postinstall": "nuxt prepare & prisma generate",
    "init-db": "prisma db pull & prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/0_init/migration.sql & prisma migrate resolve --applied 0_init & prisma generate"
  },
  "devDependencies": {
    "@cedric-ruiu/stylelint-config": "1.0.4",
    "@iconify-json/fa6-brands": "1.2.6",
    "@mermaid-js/mermaid-cli": "11.15.0",
    "@nuxt/content": "3.14.0",
    "@nuxt/eslint": "1.15.2",
    "@nuxtjs/seo": "5.1.3",
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/client": "7.8.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/image-size": "0.8.0",
    "@unhead/vue": "3.1.0",
    "@unocss/nuxt": "66.7.0",
    "@unocss/preset-icons": "66.7.0",
    "@unocss/preset-typography": "66.7.0",
    "@unocss/preset-web-fonts": "66.7.0",
    "@unocss/preset-wind4": "66.7.0",
    "better-sqlite3": "12.10.0",
    "eslint": "10.4.0",
    "nuxt": "4.4.6",
    "nuxt-seo-utils": "8.1.11",
    "photoswipe": "5.4.4",
    "postcss": "8.5.15",
    "postcss-scss": "4.0.9",
    "prisma": "7.8.0",
    "prisma-erd-generator": "2.4.2",
    "sass": "1.100.0",
    "satori": "0.26.0",
    "stylelint": "17.12.0",
    "tailwind-sorter": "1.0.3",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.9.4",
  "dependencies": {
    "image-size": "2.0.2"
  }
}
